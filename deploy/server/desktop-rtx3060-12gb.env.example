# Dirección LAN fija o reservada por DHCP. No uses 0.0.0.0 salvo necesidad.
LOCAL_AI_SERVER_HOST=192.168.3.42
LOCAL_AI_SERVER_PORT=8080

# Identificador estable que usarán los clientes OpenAI-compatible.
LOCAL_AI_SERVER_ALIAS=local-agent

# Perfil equilibrado para RTX 3060 12 GB y agentes ligeros concurrentes.
LOCAL_AI_SERVER_CTX_SIZE=8192
LOCAL_AI_SERVER_PARALLEL=2
LOCAL_AI_SERVER_GPU_LAYERS=99
LOCAL_AI_SERVER_THREADS=8
LOCAL_AI_SERVER_THREADS_BATCH=16
LOCAL_AI_SERVER_THREADS_HTTP=4

# La clave se almacena en un fichero separado con permisos 0600.
LOCAL_AI_SERVER_API_KEY_FILE=/home/carlos/.config/local-ai/api-keys
