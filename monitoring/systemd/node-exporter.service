[Unit]
Description=Prometheus node exporter for local AI monitoring
After=network-online.target

[Service]
User=prometheus
ExecStart=/usr/bin/prometheus-node-exporter --web.listen-address=127.0.0.1:9100 --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
Restart=on-failure

[Install]
WantedBy=multi-user.target
